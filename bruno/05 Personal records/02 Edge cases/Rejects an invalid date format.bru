meta {
  name: Rejects an invalid date format
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/users/{{userId}}/personal-records?exerciseName=Bench%20Press&from=2026%2F09%2F01
  body: none
  auth: none
}

params:query {
  exerciseName: Bench%20Press
  from: 2026%2F09%2F01
}

tests {
  test("responds 400", function () {
    expect(res.getStatus()).to.equal(400);
  });

  test("is a VALIDATION_ERROR naming the offending fields", function () {
    const body = res.getBody();
    expect(body.code).to.equal("VALIDATION_ERROR");
    expect(body.message).to.equal("Request validation failed");
    expect(body.errors).to.deep.equal([
      {
        "field": "from",
        "message": "from must be a date in YYYY-MM-DD format"
      }
    ]);
  });
}
