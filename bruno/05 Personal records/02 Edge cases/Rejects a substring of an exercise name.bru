meta {
  name: Rejects a substring of an exercise name
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/users/{{userId}}/personal-records?exerciseName=Bench
  body: none
  auth: none
}

params:query {
  exerciseName: Bench
}

tests {
  test("responds 400", function () {
    expect(res.getStatus()).to.equal(400);
  });

  test("is a VALIDATION_ERROR naming the offending fields", function () {
    const body = res.getBody();
    expect(body.code).to.equal("VALIDATION_ERROR");
    expect(body.message).to.equal("Request validation failed");
    expect(body.errors).to.deep.equal([
      {
        "field": "exerciseName",
        "message": "Unknown exercise \"Bench\". GET /exercises lists the valid names"
      }
    ]);
  });
}

docs {
  Unlike the history filter, personal records need an exact catalog name.
}
