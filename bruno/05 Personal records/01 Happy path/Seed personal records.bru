script:pre-request {
  bru.setVar("userId", bru.getVar("newUserId"));
}

tests {
  test("responds 201", function () {
    expect(res.getStatus()).to.equal(201);
  });

  test("stores the seven entries and saves their ids", function () {
    const ids = res.getBody().data.map(function (e) { return e.id; });
    expect(ids).to.have.length(7);
    bru.setVar("prEntryIds", JSON.stringify(ids));
  });
}

docs {
  Creates a fresh user and logs the dataset the requests in this folder assert against.
  Entry ids are saved by position in `prEntryIds`:

  | # | Date | Exercise | Sets |
  |---|------|----------|------|
  | 0 | 2026-09-08 | Bench Press | 5 × 100 kg, 3 × 105 kg |
  | 1 | 2026-09-22 | Bench Press | 1 × 110 kg |
  | 2 | 2026-10-06 | Bench Press | 3 × 112.5 kg, 8 × 95 kg |
  | 3 | 2026-10-12 | Bench Press | 1 × 112.5 kg (ties the max weight later) |
  | 4 | 2026-10-08 | Back Squat | 5 × 225 lb |
  | 5 | 2026-09-10 | Pull-Up | 10 × 0 kg (bodyweight) |
  | 6 | 2026-10-10 | Pull-Up | 5 × 10 kg |
}
