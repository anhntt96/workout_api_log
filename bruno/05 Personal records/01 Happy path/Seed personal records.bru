meta {
  name: Seed personal records
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/users/{{userId}}/workout-entries
  body: json
  auth: none
}

body:json {
  {
    "entries": [
      {
        "date": "2026-09-08",
        "exerciseName": "Bench Press",
        "sets": [
          {
            "reps": 5,
            "weight": 100,
            "unit": "kg"
          },
          {
            "reps": 3,
            "weight": 105,
            "unit": "kg"
          }
        ]
      },
      {
