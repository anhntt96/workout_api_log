meta {
  name: Empty: user without entries
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/users/{{newUserId}}/personal-records?exerciseName=Bench%20Press
  body: none
  auth: none
}

params:query {
  exerciseName: Bench%20Press
}

tests {
  test("responds 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns null records with a message", function () {
    expect(res.getBody().data.records).to.deep.equal({ maxWeight: null, maxVolume: null, bestE1rm: null });
    expect(res.getBody().message).to.equal("No Bench Press entries found for this user.");
  });
}
