meta {
  name: Records from a date (only from)
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/users/{{userId}}/personal-records?exerciseName=Bench%20Press&from=2026-10-07
  body: none
  auth: none
}

params:query {
  exerciseName: Bench%20Press
  from: 2026-10-07
}

tests {
  test("responds 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns the expected records", function () {
    const ids = JSON.parse(bru.getVar("prEntryIds"));
    const rec = function (value, weight, reps, date, i) {
      return { value: value, weight: weight, reps: reps, date: date, entryId: ids[i] };
    };
    expect(res.getBody().data).to.deep.equal({ exerciseName: "Bench Press", unit: "kg", from: "2026-10-07", to: null, records: {
      maxWeight: rec(112.5, 112.5, 1, "2026-10-12", 3),
      maxVolume: rec(112.5, 112.5, 1, "2026-10-12", 3),
      bestE1rm: rec(116.25, 112.5, 1, "2026-10-12", 3)
    } });
  });
}
