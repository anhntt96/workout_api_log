meta {
  name: All-time records in kg
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/users/{{userId}}/personal-records?exerciseName=Bench%20Press
  body: none
  auth: none
}

params:query {
  exerciseName: Bench%20Press
}

tests {
  test("responds 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns the expected records", function () {
    const ids = JSON.parse(bru.getVar("prEntryIds"));
    const rec = function (value, weight, reps, date, i) {
      return { value: value, weight: weight, reps: reps, date: date, entryId: ids[i] };
    };
    expect(res.getBody().data).to.deep.equal({ exerciseName: "Bench Press", unit: "kg", from: null, to: null, records: {
      maxWeight: rec(112.5, 112.5, 3, "2026-10-06", 2),
      maxVolume: rec(760, 95, 8, "2026-10-06", 2),
      bestE1rm: rec(123.75, 112.5, 3, "2026-10-06", 2)
    } });
  });

  test("has no message", function () {
    expect(res.getBody()).to.not.have.property("message");
  });
}

docs {
  Max weight (112.5 kg) was matched again on 2026-10-12, but the record keeps the day it was first reached, 2026-10-06. Volume and E1RM come from different sets of the same entry.
}
