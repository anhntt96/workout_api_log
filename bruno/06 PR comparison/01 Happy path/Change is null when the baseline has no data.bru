meta {
  name: Change is null when the baseline has no data
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/users/{{userId}}/personal-records/comparison?exerciseName=Bench%20Press&from=2026-10-01&to=2026-10-31&baselineFrom=2025-01-01&baselineTo=2025-01-31
  body: none
  auth: none
}

params:query {
  exerciseName: Bench%20Press
  from: 2026-10-01
  to: 2026-10-31
  baselineFrom: 2025-01-01
  baselineTo: 2025-01-31
}

tests {
  test("responds 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns current records, null baseline records and null changes", function () {
    const data = res.getBody().data;
    expect(data.current.records.maxWeight.value).to.equal(112.5);
    expect(data.baseline.records).to.deep.equal({ maxWeight: null, maxVolume: null, bestE1rm: null });
    expect(data.change).to.deep.equal({ maxWeight: null, maxVolume: null, bestE1rm: null });
    expect(res.getBody()).to.not.have.property("message");
  });
}
