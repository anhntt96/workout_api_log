meta {
  name: Rejects reversed ranges
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/users/{{userId}}/personal-records/comparison?exerciseName=Bench%20Press&from=2026-10-31&to=2026-10-01&baselineFrom=2026-09-30&baselineTo=2026-09-01
  body: none
  auth: none
}

params:query {
  exerciseName: Bench%20Press
  from: 2026-10-31
  to: 2026-10-01
  baselineFrom: 2026-09-30
  baselineTo: 2026-09-01
}

tests {
  test("responds 400", function () {
    expect(res.getStatus()).to.equal(400);
  });

  test("is a VALIDATION_ERROR naming the offending fields", function () {
    const body = res.getBody();
    expect(body.code).to.equal("VALIDATION_ERROR");
    expect(body.message).to.equal("Request validation failed");
    expect(body.errors).to.deep.equal([
      {
        "field": "from",
        "message": "from must be on or before to"
      },
      {
        "field": "baselineFrom",
        "message": "baselineFrom must be on or before baselineTo"
      }
    ]);
  });
}
