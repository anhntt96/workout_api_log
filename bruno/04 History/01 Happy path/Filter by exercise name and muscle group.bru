meta {
  name: Filter by exercise name and muscle group
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/users/{{userId}}/workout-entries?exerciseName=squat&muscleGroup=quadriceps
  body: none
  auth: none
}

params:query {
  exerciseName: squat
  muscleGroup: quadriceps
}

tests {
  test("responds 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns entries matching both filters", function () {
    const seeded = JSON.parse(bru.getVar("historyIds"));
    const expected = [1].map(function (i) { return seeded[i]; }).sort();
    expect(res.getBody().data.map(function (e) { return e.id; }).sort()).to.deep.equal(expected);
  });
}
