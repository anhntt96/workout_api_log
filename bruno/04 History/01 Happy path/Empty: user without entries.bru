meta {
  name: Empty: user without entries
  type: http
  seq: 21
}

get {
  url: {{baseUrl}}/users/{{newUserId}}/workout-entries
  body: none
  auth: none
}

tests {
  test("responds 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns an empty page with a message", function () {
    const body = res.getBody();
    expect(body.data).to.deep.equal([]);
    expect(body.page.nextCursor).to.equal(null);
    expect(body.message).to.equal("No workout entries match the given filters.");
  });
}

docs {
  There is no users table: an unknown `userId` is simply a client with no entries.
}
