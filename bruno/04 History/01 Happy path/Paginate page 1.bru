meta {
  name: Paginate page 1
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/users/{{userId}}/workout-entries?limit=2
  body: none
  auth: none
}

params:query {
  limit: 2
}

tests {
  test("responds 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("is ordered newest first", function () {
    expect(res.getBody().data.map(function (e) { return e.date; })).to.deep.equal(["2026-10-06","2026-10-06"]);
  });

  test("returns a cursor for the next page", function () {
    const page = res.getBody().page;
    expect(page.limit).to.equal(2);
    expect(page.nextCursor).to.be.a("string").and.match(/^[A-Za-z0-9_-]+$/);
    bru.setVar("historyCursor", page.nextCursor);
    bru.setVar("historyPagedIds", JSON.stringify(res.getBody().data.map(function (e) { return e.id; })));
  });
}
