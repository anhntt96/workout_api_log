meta {
  name: Seed history
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/users/{{userId}}/workout-entries
  body: json
  auth: none
}

body:json {
  {
    "entries": [
      {
        "date": "2026-09-08",
        "exerciseName": "Bench Press",
        "sets": [
          {
            "reps": 5,
            "weight": 100,
            "unit": "kg"
          },
          {
            "reps": 3,
            "weight": 105,
            "unit": "kg"
          }
        ]
      },
      {
        "date": "2026-09-08T18:30:00+07:00",
        "exerciseName": "Back Squat",
        "sets": [
          {
            "reps": 5,
            "weight": 225,
            "unit": "lb"
          }
        ]
      },
      {
        "date": "2026-09-22",
        "exerciseName": "Bench Press",
        "sets": [
          {
            "reps": 1,
            "weight": 110,
            "unit": "kg"
          }
        ]
      },
      {
        "date": "2026-10-06",
        "exerciseName": "Bench Press",
        "sets": [
          {
            "reps": 3,
            "weight": 112.5,
            "unit": "kg"
          },
          {
            "reps": 8,
            "weight": 95,
            "unit": "kg"
          }
        ]
      },
      {
        "date": "2026-10-06",
        "exerciseName": "Pull-Up",
        "sets": [
          {
            "reps": 10,
            "weight": 0,
            "unit": "kg"
          }
        ]
      }
    ]
  }
}

script:pre-request {
  bru.setVar("userId", bru.getVar("newUserId"));
}

tests {
  test("responds 201", function () {
    expect(res.getStatus()).to.equal(201);
  });

  test("saves the entry ids", function () {
    bru.setVar("historyIds", JSON.stringify(res.getBody().data.map(function (e) { return e.id; })));
  });
}

docs {
  Creates a fresh user and logs the dataset the requests in this folder assert against (ids saved in `historyIds`):

  | # | Date | Exercise | Sets |
  |---|------|----------|------|
  | 0 | 2026-09-08 | Bench Press | 5 × 100 kg, 3 × 105 kg |
  | 1 | 2026-09-08 (sent as 18:30+07:00) | Back Squat | 5 × 225 lb |
  | 2 | 2026-09-22 | Bench Press | 1 × 110 kg |
  | 3 | 2026-10-06 | Bench Press | 3 × 112.5 kg, 8 × 95 kg |
  | 4 | 2026-10-06 | Pull-Up | 10 × 0 kg |
}
