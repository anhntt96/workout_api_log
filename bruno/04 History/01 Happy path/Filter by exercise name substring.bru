meta {
  name: Filter by exercise name substring
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/users/{{userId}}/workout-entries?exerciseName=PRESS
  body: none
  auth: none
}

params:query {
  exerciseName: PRESS
}

tests {
  test("responds 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("is ordered newest first", function () {
    expect(res.getBody().data.map(function (e) { return e.date; })).to.deep.equal(["2026-10-06","2026-09-22","2026-09-08"]);
  });

  test("returns only Bench Press", function () {
    const seeded = JSON.parse(bru.getVar("historyIds"));
    const expected = [0, 2, 3].map(function (i) { return seeded[i]; }).sort();
    expect(res.getBody().data.map(function (e) { return e.id; }).sort()).to.deep.equal(expected);
  });
}

docs {
  `exerciseName` here is a case-insensitive substring, so `PRESS` matches Bench Press.
}
