meta {
  name: Filter with only from
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/users/{{userId}}/workout-entries?from=2026-10-01
  body: none
  auth: none
}

params:query {
  from: 2026-10-01
}

tests {
  test("responds 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns entries on or after from", function () {
    const seeded = JSON.parse(bru.getVar("historyIds"));
    const expected = [3, 4].map(function (i) { return seeded[i]; }).sort();
    expect(res.getBody().data.map(function (e) { return e.id; }).sort()).to.deep.equal(expected);
  });
}
