meta {
  name: Rejects empty filters
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/users/{{userId}}/workout-entries?exerciseName=%20&muscleGroup=
  body: none
  auth: none
}

params:query {
  exerciseName: %20
  muscleGroup:
}

tests {
  test("responds 400", function () {
    expect(res.getStatus()).to.equal(400);
  });

  test("is a VALIDATION_ERROR naming the offending fields", function () {
    const body = res.getBody();
    expect(body.code).to.equal("VALIDATION_ERROR");
    expect(body.message).to.equal("Request validation failed");
    expect(body.errors).to.deep.equal([
      {
        "field": "exerciseName",
        "message": "exerciseName must not be empty"
      },
      {
        "field": "muscleGroup",
        "message": "muscleGroup must not be empty"
      }
    ]);
  });
}
