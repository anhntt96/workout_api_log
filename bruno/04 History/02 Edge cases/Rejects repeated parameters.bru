meta {
  name: Rejects repeated parameters
  type: http
  seq: 16
}

get {
  url: {{baseUrl}}/users/{{userId}}/workout-entries?exerciseName=bench&exerciseName=squat&limit=1&limit=2
  body: none
  auth: none
}

params:query {
  exerciseName: bench
  exerciseName: squat
  limit: 1
  limit: 2
}

tests {
  test("responds 400", function () {
    expect(res.getStatus()).to.equal(400);
  });

  test("is a VALIDATION_ERROR naming the offending fields", function () {
    const body = res.getBody();
    expect(body.code).to.equal("VALIDATION_ERROR");
    expect(body.message).to.equal("Request validation failed");
    expect(body.errors).to.deep.equal([
      {
        "field": "exerciseName",
        "message": "exerciseName must be a string"
      },
      {
        "field": "limit",
        "message": "limit must be a number"
      }
    ]);
  });
}
