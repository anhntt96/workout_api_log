meta {
  name: Rejects a tampered cursor
  type: http
  seq: 14
}

get {
  url: {{baseUrl}}/users/{{userId}}/workout-entries?cursor=WyIyMDI2LTA5LTA4IiwieCIsInkiXQ
  body: none
  auth: none
}

params:query {
  cursor: WyIyMDI2LTA5LTA4IiwieCIsInkiXQ
}

tests {
  test("responds 400", function () {
    expect(res.getStatus()).to.equal(400);
  });

  test("is a VALIDATION_ERROR naming the offending fields", function () {
    const body = res.getBody();
    expect(body.code).to.equal("VALIDATION_ERROR");
    expect(body.message).to.equal("Request validation failed");
    expect(body.errors).to.deep.equal([
      {
        "field": "cursor",
        "message": "cursor is invalid; use nextCursor from the previous page"
      }
    ]);
  });
}

docs {
  Valid base64url, but it decodes to `["2026-09-08","x","y"]`, which is not a cursor the API produced.
}
