meta {
  name: Exercise name and unit match case-insensitively
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/users/{{userId}}/workout-entries
  body: json
  auth: none
}

body:json {
  {
    "entries": [
      {
        "date": "2026-09-14",
        "exerciseName": "  bench PRESS  ",
        "sets": [
          {
            "reps": 5,
            "weight": 135,
            "unit": "LB"
          },
          {
            "reps": 5,
            "weight": 60,
            "unit": " Kg "
          }
        ]
      }
    ]
  }
}

tests {
  test("responds 201", function () {
    expect(res.getStatus()).to.equal(201);
  });

  test("returns the canonical exercise name", function () {
    expect(res.getBody().data[0].exerciseName).to.equal("Bench Press");
  });

  test("returns units in lower case", function () {
    expect(res.getBody().data[0].sets).to.deep.equal([
      { reps: 5, weight: 135, unit: "lb" },
      { reps: 5, weight: 60, unit: "kg" }
    ]);
  });
}
