meta {
  name: Same-day repeats both appear in history
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/users/{{userId}}/workout-entries?exerciseName=Overhead%20Press&from=2026-09-20&to=2026-09-20
  body: none
  auth: none
}

params:query {
  exerciseName: Overhead%20Press
  from: 2026-09-20
  to: 2026-09-20
}

tests {
  test("responds 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("lists two entries for the day", function () {
    expect(res.getBody().data).to.have.length(2);
  });
}
