meta {
  name: Same-day repeat 1 of 2
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/users/{{userId}}/workout-entries
  body: json
  auth: none
}

body:json {
  {
    "entries": [
      {
        "date": "2026-09-20",
        "exerciseName": "Overhead Press",
        "sets": [
          {
            "reps": 5,
            "weight": 60,
            "unit": "kg"
          }
        ]
      }
    ]
  }
}

tests {
  test("responds 201", function () {
    expect(res.getStatus()).to.equal(201);
  });

  test("saves the entry id", function () {
    bru.setVar("sameDayFirstId", res.getBody().data[0].id);
  });
}
