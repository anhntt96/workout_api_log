}

tests {
  test("responds 400", function () {
    expect(res.getStatus()).to.equal(400);
  });

  test("is a BAD_REQUEST from the JSON parser", function () {
    const body = res.getBody();
    expect(body.code).to.equal("BAD_REQUEST");
    expect(body.message).to.be.a("string").and.not.be.empty;
    expect(body).to.not.have.property("errors");
  });
}
