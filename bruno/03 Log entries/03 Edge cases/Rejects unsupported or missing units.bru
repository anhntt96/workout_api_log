meta {
  name: Rejects unsupported or missing units
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/users/{{userId}}/workout-entries
  body: json
  auth: none
}

body:json {
  {
    "entries": [
      {
        "date": "2026-09-08",
        "exerciseName": "Bench Press",
        "sets": [
          {
            "reps": 1,
            "weight": 1,
            "unit": "stone"
          },
          {
            "reps": 1,
            "weight": 1,
            "unit": ""
          },
          {
            "reps": 1,
            "weight": 1
          },
          {
            "reps": 1,
            "weight": 1,
            "unit": 1
          }
        ]
      }
    ]
  }
}

tests {
  test("responds 400", function () {
    expect(res.getStatus()).to.equal(400);
  });

  test("is a VALIDATION_ERROR naming the offending fields", function () {
    const body = res.getBody();
    expect(body.code).to.equal("VALIDATION_ERROR");
    expect(body.message).to.equal("Request validation failed");
    expect(body.errors).to.deep.equal([
      {
        "field": "entries[0].sets[0].unit",
        "message": "Unsupported unit \"stone\". Supported units: kg, lb"
      },
      {
        "field": "entries[0].sets[1].unit",
        "message": "Unsupported unit \"\". Supported units: kg, lb"
      },
      {
        "field": "entries[0].sets[2].unit",
        "message": "unit is required"
      },
      {
        "field": "entries[0].sets[3].unit",
        "message": "unit must be a string"
      }
    ]);
  });
}
