meta {
  name: Rejects invalid reps
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/users/{{userId}}/workout-entries
  body: json
  auth: none
}

body:json {
  {
    "entries": [
      {
        "date": "2026-09-08",
        "exerciseName": "Bench Press",
        "sets": [
          {
            "reps": 0,
            "weight": 100,
            "unit": "kg"
          },
          {
            "reps": 1.5,
            "weight": 100,
            "unit": "kg"
          },
          {
            "reps": 1001,
            "weight": 100,
            "unit": "kg"
          },
          {
            "reps": "5",
            "weight": 100,
            "unit": "kg"
          }
        ]
      }
    ]
  }
}

tests {
  test("responds 400", function () {
    expect(res.getStatus()).to.equal(400);
  });

  test("is a VALIDATION_ERROR naming the offending fields", function () {
    const body = res.getBody();
    expect(body.code).to.equal("VALIDATION_ERROR");
    expect(body.message).to.equal("Request validation failed");
    expect(body.errors).to.deep.equal([
      {
        "field": "entries[0].sets[0].reps",
        "message": "reps must be at least 1"
      },
      {
        "field": "entries[0].sets[1].reps",
        "message": "reps must be a whole number"
      },
      {
        "field": "entries[0].sets[2].reps",
        "message": "reps must be at most 1000"
      },
      {
        "field": "entries[0].sets[3].reps",
        "message": "reps must be a number"
      }
    ]);
  });
}
