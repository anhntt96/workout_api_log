meta {
  name: Rejects a key longer than 200 characters
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/users/{{newUserId}}/workout-entries
  body: json
  auth: none
}

body:json {
  {
    "entries": [
      {
        "date": "2026-09-08",
        "exerciseName": "Bench Press",
        "sets": [
          {
            "reps": 5,
            "weight": 100,
            "unit": "kg"
          }
        ]
      }
    ]
  }
}

script:pre-request {
  req.setHeader("Idempotency-Key", "k".repeat(201));
}

tests {
  test("responds 400", function () {
    expect(res.getStatus()).to.equal(400);
  });

  test("is a VALIDATION_ERROR naming the offending fields", function () {
    const body = res.getBody();
    expect(body.code).to.equal("VALIDATION_ERROR");
    expect(body.message).to.equal("Request validation failed");
    expect(body.errors).to.deep.equal([
      {
        "field": "Idempotency-Key",
        "message": "Idempotency-Key must be 1-200 visible ASCII characters without spaces"
      }
    ]);
  });
}

docs {
  The header is set by the pre-request script.
}
